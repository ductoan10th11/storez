{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply store-db --local",
    "db:seed": "wrangler d1 execute store-db --local --file=./seed/seed-catalog.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed",
    "db:migrate:remote": "wrangler d1 migrations apply store-db --remote",
    "db:seed:remote": "wrangler d1 execute store-db --remote --file=./seed/seed-catalog.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.0.0"
  }
}
